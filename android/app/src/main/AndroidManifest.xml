<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- MICROFONO PARA EL SIMULADOR DE ENTREVISTAS.
         No estaba declarado, asi que en Android el dictado no podia funcionar
         de ninguna manera: sin RECORD_AUDIO el sistema ni siquiera ofrece
         conceder el permiso. La aplicacion mostraba "Microfono bloqueado" y
         mandaba a Ajustes, donde no habia nada que activar. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- UBICACION PARA LA CAMARA DE GUZZI (oct 2026). Sin declararla, Capacitor la
         pide y Android la deniega sin preguntar: la camara buscaba alrededor de la
         ciudad del perfil y no donde estaba la persona. Con el perfil en Tudela y
         una foto en Pamplona, salia el "Cafe Iruna" de Sartaguda y el Mercadona de
         Tudela. Las dos, porque Capacitor pide las dos; quien quiera puede elegir
         "aproximada" en el aviso. El uses-feature en false es para que Google Play
         no oculte la app a los moviles sin GPS. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- Android 11+ exige declarar con que apps se habla. El reconocimiento de
         voz vive en otra app del sistema; sin esto, SpeechRecognizer no la ve. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
